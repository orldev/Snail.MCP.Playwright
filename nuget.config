<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Snail.Toolkit.Web is not published yet, so its packages travel with this repository in packages/.
    tools/pack-toolkit.sh rebuilds them from the toolkit's checkout. The mapping pins the route: a public
    package of the same name can never shadow the bundled one.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="Bundled" value="./packages" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="Bundled">
      <package pattern="Snail.Toolkit.Web*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
