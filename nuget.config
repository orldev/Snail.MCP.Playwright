<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Snail.Toolkit.Web is not published yet, so its packages travel with this repository in packages/.
    tools/pack-toolkit.sh rebuilds them from the toolkit's checkout.

    Central package management with more than one feed configured requires an explicit mapping (NU1507). Without it a
    public package can shadow a private one of the same name, which is the dependency-confusion attack. The longest
    matching pattern wins, so Snail.Toolkit.Web* resolves to the bundled packages.
  -->
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="Bundled" value="./packages" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="Bundled">
      <package pattern="Snail.Toolkit.Web*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
