<Project Sdk="Snail.Sdk.Mcp">

    <!--
        Framework-dependent: Playwright drives the browser through its Node driver and reflection, which a native program
        cannot. Stdio for the client that started it, HTTP beside the browser in Docker.
    -->
    <PropertyGroup>
        <SnailMcpNative>false</SnailMcpNative>
        <SnailMcpTransport>Both</SnailMcpTransport>
        <SnailMcpContainer>true</SnailMcpContainer>
    </PropertyGroup>

    <PropertyGroup>
        <Version>0.1.0</Version>
        <Description>MCP server that lets AI agents search the web and read pages through a real browser: links for a query, the text of a page, several pages at once and a bounded walk over a site. Built on Snail.Toolkit.Web and a Playwright browser server; answers sessions at an address beside the browser in Docker, or speaks stdio to the client that started it.</Description>
        <PackageTags>mcp;mcp-server;modelcontextprotocol;ai;claude;playwright;search;scraping;dotnet-tool</PackageTags>
        <PackageProjectUrl>https://github.com/orldev/Snail.MCP.Playwright</PackageProjectUrl>
        <RepositoryUrl>https://github.com/orldev/Snail.MCP.Playwright</RepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Fizzler.Systems.HtmlAgilityPack"/>
        <PackageReference Include="ModelContextProtocol"/>
        <PackageReference Include="ModelContextProtocol.AspNetCore"/>
    </ItemGroup>

    <!-- Bundled in packages/ until the toolkit is published; tools/pack-toolkit.sh rebuilds them. -->
    <ItemGroup>
        <PackageReference Include="Snail.Toolkit.Web.Scraping.Agent"/>
        <PackageReference Include="Snail.Toolkit.Web.Search.Browser"/>
        <PackageReference Include="Snail.Toolkit.Web.Search.Browser.Agent"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Snail.MCP.Playwright.Tests"/>
    </ItemGroup>

</Project>
