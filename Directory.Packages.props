<Project>
  <!-- Central package management: every version this repository uses, once. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Runtime">
    <PackageVersion Include="Fizzler.Systems.HtmlAgilityPack" Version="1.2.1" />
    <PackageVersion Include="ModelContextProtocol" Version="2.3.1" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.3.1" />
  </ItemGroup>
  <!-- Snail.Toolkit.Web, released together: the three move as one version. -->
  <ItemGroup Label="Toolkit">
    <PackageVersion Include="Snail.Toolkit.Web.Scraping.Agent" Version="0.2.0" />
    <PackageVersion Include="Snail.Toolkit.Web.Search.Browser" Version="0.2.0" />
    <PackageVersion Include="Snail.Toolkit.Web.Search.Browser.Agent" Version="0.2.0" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
